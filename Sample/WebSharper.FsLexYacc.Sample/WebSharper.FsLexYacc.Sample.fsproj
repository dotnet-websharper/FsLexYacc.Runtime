<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <WebSharperSourceMap>false</WebSharperSourceMap>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <!-- FS3886: single-element list in a generated lexer/parser.
         NU1510: System.Reflection.Emit.Lightweight (via WebSharper) need not be referenced explicitly. -->
    <NoWarn>$(NoWarn);FS3886;NU1510</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- The lexers and parsers are generated by fslex/fsyacc from the .fsl/.fsy
         sources at build time, using the FsLexYacc toolkit (see paket.references). -->
    <Compile Include="JsonValue.fs" />
    <FsYacc Include="JsonParser.fsy">
      <OtherFlags>--module JsonParser</OtherFlags>
    </FsYacc>
    <FsLex Include="JsonLexer.fsl">
      <OtherFlags>--unicode</OtherFlags>
    </FsLex>
    <Compile Include="$(FsYaccOutputFolder)JsonParser.fs" />
    <Compile Include="$(FsLexOutputFolder)JsonLexer.fs" />
    <FsYacc Include="HelloParser.fsy">
      <OtherFlags>--module HelloParser</OtherFlags>
    </FsYacc>
    <FsLex Include="HelloLexer.fsl">
      <OtherFlags>--unicode</OtherFlags>
    </FsLex>
    <Compile Include="$(FsYaccOutputFolder)HelloParser.fs" />
    <Compile Include="$(FsLexOutputFolder)HelloLexer.fs" />
    <FsLex Include="AsciiLexer.fsl" />
    <Compile Include="$(FsLexOutputFolder)AsciiLexer.fs" />
    <Compile Include="Client.fs" />
    <None Include="JsonParser.fsy" />
    <None Include="JsonLexer.fsl" />
    <None Include="HelloParser.fsy" />
    <None Include="HelloLexer.fsl" />
    <None Include="AsciiLexer.fsl" />
    <None Include="package.json" />
    <None Include="esbuild.config.mjs" />
    <None Include="wsconfig.json" />
    <Content Include="index.html" />
    <Content Include="site.css" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\FsLexYacc.Runtime\FsLexYacc.Runtime.fsproj" />
    <ProjectReference Include="..\..\websharper\WebSharper.FsLexYacc.Runtime\WebSharper.FsLexYacc.Runtime.fsproj" />
  </ItemGroup>
  <Target Name="ESBuildBundle" AfterTargets="WebSharperCompile">
    <Exec Command="npm install" />
    <Exec Command="node ./esbuild.config.mjs" />
  </Target>
  <Import Project="..\..\.paket\Paket.Restore.targets" />
</Project>
