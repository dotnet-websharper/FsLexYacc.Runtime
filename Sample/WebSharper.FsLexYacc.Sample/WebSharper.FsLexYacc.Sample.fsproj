<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <DefineConstants>$(DefineConstants);JAVASCRIPT</DefineConstants>
    <WebSharperSourceMap>false</WebSharperSourceMap>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <!-- FS3886: single-element list in a generated lexer/parser.
         NU1510: System.Reflection.Emit.Lightweight (via WebSharper) need not be referenced explicitly. -->
    <NoWarn>$(NoWarn);FS3886;NU1510</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- The lexers/parsers below are generated by fslex/fsyacc from the .fsl/.fsy
         sources next to them (with FsLexYacc 13), and committed so the sample
         builds without running the tools. See the repository README. -->
    <Compile Include="JsonValue.fs" />
    <Compile Include="JsonParser.fs" />
    <Compile Include="JsonLexer.fs" />
    <Compile Include="HelloParser.fs" />
    <Compile Include="HelloLexer.fs" />
    <Compile Include="AsciiLexer.fs" />
    <Compile Include="Client.fs" />
    <None Include="JsonParser.fsy" />
    <None Include="JsonLexer.fsl" />
    <None Include="HelloParser.fsy" />
    <None Include="HelloLexer.fsl" />
    <None Include="AsciiLexer.fsl" />
    <None Include="package.json" />
    <None Include="esbuild.config.mjs" />
    <None Include="wsconfig.json" />
    <Content Include="index.html" />
    <Content Include="site.css" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\FsLexYacc.Runtime\FsLexYacc.Runtime.fsproj" />
    <ProjectReference Include="..\..\websharper\WebSharper.FsLexYacc.Runtime\WebSharper.FsLexYacc.Runtime.fsproj" />
  </ItemGroup>
  <Target Name="ESBuildBundle" AfterTargets="WebSharperCompile">
    <Exec Command="npm install" />
    <Exec Command="node ./esbuild.config.mjs" />
  </Target>
  <Import Project="..\..\.paket\Paket.Restore.targets" />
</Project>
